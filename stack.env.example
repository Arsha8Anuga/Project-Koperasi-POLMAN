# Salin nilai-nilai ini ke Portainer → Stack → Environment variables (Advanced mode bisa paste sekaligus).
# JANGAN commit file berisi nilai asli.

# Password: karakter khusus wajib di-URL-encode (+ → %2B, @ → %40, / → %2F, : → %3A)
MONGODB_URI=mongodb://USER:PASSWORD@db-proj-aec3.zenahost.my.id:40008/?authSource=admin&directConnection=true
MONGODB_DB=koperasi_demo

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=480

# Backend: port di DALAM container (dipakai nginx kasir/admin) dan port di host (hanya untuk debug/Swagger).
BACKEND_PORT=8000
BACKEND_HOST_PORT=30007
# 127.0.0.1 = hanya bisa dibuka dari server itu sendiri. Jangan 0.0.0.0 kecuali tahu risikonya.
BACKEND_BIND=127.0.0.1

# Port di host yang dituju reverse proxy (Nginx Proxy Manager / Traefik / Caddy).
KASIR_PORT=8081
ADMIN_PORT=8082
# Isi 127.0.0.1 kalau reverse proxy berjalan di host yang sama dengan network_mode host / non-Docker,
# supaya port tidak bisa dibuka langsung tanpa HTTPS.
KASIR_BIND=0.0.0.0
ADMIN_BIND=0.0.0.0

# AI engine (opsional, ada nilai bawaan)
AI_INTERVAL_MINUTES=15
AI_LEAD_TIME_DAYS=3
AI_REVIEW_DAYS=7
AI_SERVICE_LEVEL=0.95
