# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit.

# --- MongoDB ---
# Wajib replica set (transaction). URI server tim diminta ke integrator lewat chat pribadi.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=koperasi_dev

# --- Auth ---
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=480

# --- Lain-lain ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_TZ=Asia/Jakarta

# --- Test (pytest) ---
# Pakai nama DB sendiri supaya test dua orang tidak saling menghapus. DB ini DI-DROP tiap test.
TEST_MONGODB_DB=koperasi_test_namamu
